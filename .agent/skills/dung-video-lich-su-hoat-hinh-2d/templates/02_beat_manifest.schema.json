{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZiroHistoryBeatManifestSchema",
  "type": "object",
  "required": ["episode_id", "act_id", "cluster_id", "cluster_type", "author_visual_note", "bgm_track", "total_duration_sec", "beats"],
  "properties": {
    "episode_id": { "type": "string" },
    "act_id": { "type": "string" },
    "cluster_id": { "type": "string" },
    "cluster_type": { "type": "string", "enum": ["HOI_PHAN_TICH", "SKIT_CHAM_BIEM"] },
    "author_visual_note": { "type": "string" },
    "bgm_track": { "type": "string", "enum": ["bgm_tense_history.wav", "bgm_satire_skit.wav"] },
    "total_duration_sec": { "type": "number", "minimum": 1.0 },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "segment_id",
          "author_visual_note",
          "wav_file",
          "source_mp3_t0",
          "source_mp3_t1",
          "t0",
          "t1",
          "duration",
          "narration_text",
          "lighting_mode",
          "scene_template",
          "hud_banner",
          "camera",
          "characters",
          "sub_triggers_bt",
          "sfx_events"
        ],
        "properties": {
          "beat_id": { "type": "string" },
          "segment_id": { "type": "string" },
          "author_visual_note": { "type": "string" },
          "beat_cache_hash": { "type": "string" },
          "wav_file": { "type": "string" },
          "source_mp3_t0": { "type": "number", "minimum": 0.0 },
          "source_mp3_t1": { "type": "number", "minimum": 0.1 },
          "t0": { "type": "number", "minimum": 0.0 },
          "t1": { "type": "number", "minimum": 0.1 },
          "duration": { "type": "number", "minimum": 0.1 },
          "narration_text": { "type": "string" },
          "lighting_mode": { "type": "string", "enum": ["DAYLIGHT_WARM", "SAND_EMPIRE", "PRISON_NIGHT"] },
          "scene_template": {
            "type": "string",
            "enum": [
              "T01_Split_World_Contrast",
              "T02_Three_Cards_Fly_In",
              "T03_Prison_Bars_Slam",
              "T04_Empire_Parade",
              "T05_Data_Chart_Scale",
              "T06_Geopolitics_Map_Spotlight",
              "T07_Icon_Grid_Counter",
              "T08_Fact_vs_Myth_Strike",
              "S01_General_Tent_Dialogue",
              "S02_Hollywood_Myth_vs_Reality",
              "S03_Biased_Historian_Desk",
              "S04_Field_Reporter_Gag",
              "S05_Absurd_Visual_Gag",
              "CUSTOM_METAPHOR_STAGE"
            ]
          },
          "background_image": { "type": "string" },
          "hud_banner": {
            "type": "object",
            "required": ["text", "y_center", "render_pass"],
            "properties": {
              "text": { "type": "string" },
              "style": { "type": "string", "enum": ["FRAMELESS_TYPEWRITER", "STAMP_HEADER", "NONE"] },
              "y_center": { "type": "number", "minimum": 110 },
              "render_pass": { "type": "string", "enum": ["PASS_2_POST_CAMERA"] }
            }
          },
          "camera": {
            "type": "object",
            "required": ["zoom_start", "zoom_end", "pan_x_start", "pan_x_end", "viewport_isolation_mode"],
            "properties": {
              "zoom_start": { "type": "number", "minimum": 1.0, "maximum": 1.35 },
              "zoom_end": { "type": "number", "minimum": 1.0, "maximum": 1.35 },
              "pan_x_start": { "type": "number" },
              "pan_x_end": { "type": "number" },
              "pan_y_start": { "type": "number" },
              "pan_y_end": { "type": "number" },
              "viewport_isolation_mode": { "type": "boolean" }
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "x", "y", "emotion", "neck_insert_px"],
              "properties": {
                "role": { "type": "string" },
                "label": { "type": "string" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "scale": { "type": "number" },
                "emotion": { "type": "string", "enum": ["neutral", "explaining", "shocked", "scared", "angry", "stern", "smug", "sarcastic"] },
                "neck_insert_px": { "type": "number", "minimum": 28, "maximum": 42 },
                "active_window": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "sub_triggers_bt": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["bt", "action_type", "label"],
              "properties": {
                "bt": { "type": "number", "minimum": 0.0 },
                "action_type": { "type": "string" },
                "label": { "type": "string" },
                "sub_label": { "type": "string" },
                "photo_file": { "type": "string" },
                "x_offset": { "type": "number" }
              }
            }
          },
          "sfx_events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["bt", "sfx_file", "gain_db"],
              "properties": {
                "bt": { "type": "number", "minimum": 0.0 },
                "sfx_file": {
                  "type": "string",
                  "enum": [
                    "pop_card.wav",
                    "whoosh_transition.wav",
                    "stamp_slam.wav",
                    "jail_bar_clang.wav",
                    "typewriter_tick.wav",
                    "sword_clash.wav"
                  ]
                },
                "gain_db": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
